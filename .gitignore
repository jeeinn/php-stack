# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.lingma
.kiro
.vscode
.claude
.workbuddy

# Generated files (runtime generated, not templates)
workspace.json
.env*
docker-compose.yml*
data/
logs/

# User custom version overrides (machine-specific, same level as .env)
.user_version_overrides.json
.user_mirror_config.json

# Ignore runtime services directory (but keep src-tauri/services templates)
services*/
!src-tauri/services/

# Local helper scripts (underscore-prefixed, agent-internal)
scripts/_*.sh

# Cargo 本地构建配置（磁盘迁移脚本生成，把 target-dir 指到别的盘）
# 属于机器个性化配置，不应入库；且它会导致 cargo test 找不到 src-tauri/services/
src-tauri/.cargo/
